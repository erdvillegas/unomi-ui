{
  "name": "unomi-ui",
  "version": "0.0.1",
  "private": true,
  "description": "OpenUI5 + TypeScript client for the Apache Unomi CDP REST API",
  "scripts": {
    "start": "ui5 serve --port 8090 --open index.html",
    "build": "ui5 build --clean-dest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@openui5/types": "^1.120.0",
    "@ui5/cli": "^4.0.0",
    "typescript": "^5.5.0",
    "ui5-middleware-simpleproxy": "^3.5.0",
    "ui5-tooling-transpile": "^3.0.0"
  }
}
