<mvc:View
	controllerName="unomi.ui.controller.info"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.ui.layout.form"
	xmlns="sap.m"
	displayBlock="true">
	<Page title="{i18n>info}">
		<Panel headerText="{i18n>versionInfo}" class="sapUiResponsiveMargin" width="auto">
			<f:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="3">
				<f:content>
					<Label text="{i18n>appName}" />
					<Text text="{info>/appName}" />
					<Label text="{i18n>appVersion}" />
					<Text text="{info>/appVersion}" />
					<Label text="{i18n>ui5Version}" />
					<Text text="{info>/ui5Version}" />
					<Label text="{i18n>baseUrl}" />
					<Text text="{info>/baseUrl}" />
				</f:content>
			</f:SimpleForm>
		</Panel>
		<Panel headerText="{i18n>clusterInfo}" class="sapUiResponsiveMargin" width="auto">
			<Table items="{info>/nodes}" noDataText="{i18n>noData}">
				<columns>
					<Column><Text text="{i18n>nodeHost}" /></Column>
					<Column><Text text="{i18n>nodeInternal}" /></Column>
					<Column><Text text="{i18n>nodeVersion}" /></Column>
					<Column hAlign="Center"><Text text="{i18n>nodeMaster}" /></Column>
					<Column hAlign="Center"><Text text="{i18n>nodeData}" /></Column>
					<Column hAlign="End"><Text text="{i18n>nodeCpu}" /></Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{info>publicHostAddress}" />
							<Text text="{info>internalHostAddress}" />
							<Text text="{info>serverInfo/serverVersion}" />
							<ObjectStatus state="{= ${info>master} ? 'Success' : 'None'}" text="{= ${info>master} ? '✓' : '—'}" />
							<ObjectStatus state="{= ${info>data} ? 'Success' : 'None'}" text="{= ${info>data} ? '✓' : '—'}" />
							<Text text="{= (${info>cpuLoad} * 100).toFixed(1) + ' %'}" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</Panel>
	</Page>
</mvc:View>
