<mvc:View
	controllerName="unomi.ui.controller.MetadataList"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns="sap.m"
	displayBlock="true">
	<f:DynamicPage busy="{list>/busy}" busyIndicatorDelay="0">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{list>/title} ({list>/items/length})" />
				</f:heading>
				<f:actions>
					<Button text="{i18n>common.new}" icon="sap-icon://add" type="Emphasized" press=".onNew" />
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<Table
				items="{list>/items}"
				mode="SingleSelectMaster"
				itemPress=".onPress"
				noDataText="{i18n>common.noData}">
				<columns>
					<Column><Text text="{i18n>col.name}" /></Column>
					<Column><Text text="{i18n>col.id}" /></Column>
					<Column hAlign="Center"><Text text="{i18n>col.enabled}" /></Column>
				</columns>
				<items>
					<ColumnListItem type="Navigation">
						<cells>
							<Text text="{list>name}" />
							<Text text="{list>id}" />
							<ObjectStatus
								text="{= ${list>enabled} ? 'yes' : 'no' }"
								state="{= ${list>enabled} ? 'Success' : 'None' }" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>
