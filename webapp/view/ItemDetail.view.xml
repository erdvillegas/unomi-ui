<mvc:View
	controllerName="unomi.ui.controller.ItemDetail"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	displayBlock="true">
	<Page
		title="{detail>/name}"
		showNavButton="true"
		navButtonPress=".onNavBack"
		busy="{detail>/busy}"
		busyIndicatorDelay="0">
		<VBox class="sapUiSmallMargin">
			<VBox id="formHost" />
			<VBox id="nestedHost" />
			<Panel headerText="{i18n>statistics}" visible="{detail>/hasStats}" expandable="true" expanded="false">
				<TextArea value="{detail>/stats}" editable="false" rows="12" width="100%" growing="false" />
			</Panel>
			<Panel headerText="{i18n>advancedJson}" expandable="true" expanded="false" expand=".refreshJson">
				<VBox>
					<TextArea value="{detail>/json}" editable="true" rows="18" width="100%" growing="false" />
					<Button text="{i18n>applyJson}" icon="sap-icon://synchronize" press=".onApplyJson" class="sapUiSmallMarginTop" />
				</VBox>
			</Panel>
		</VBox>
		<footer>
			<Toolbar>
				<Button text="{i18n>delete}" type="Reject" icon="sap-icon://delete" press=".onDelete" visible="{= !${detail>/isNew} }" />
				<ToolbarSpacer />
				<Button text="{i18n>save}" type="Emphasized" icon="sap-icon://save" press=".onSave" />
			</Toolbar>
		</footer>
	</Page>
</mvc:View>
