<mvc:View
	controllerName="unomi.ui.controller.ItemDetail"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:uxap="sap.uxap"
	displayBlock="true">
	<uxap:ObjectPageLayout
		showTitleInHeaderContent="true"
		showFooter="true"
		busy="{detail>/busy}"
		busyIndicatorDelay="0">
		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:heading>
					<Title text="{detail>/name}" />
				</uxap:heading>
				<uxap:navigationActions>
					<Button icon="sap-icon://nav-back" tooltip="{i18n>common.back}" press=".onNavBack" />
				</uxap:navigationActions>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>

		<uxap:sections>
			<uxap:ObjectPageSection title="{i18n>module.properties}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<uxap:blocks>
							<VBox id="formHost" />
							<VBox id="nestedHost" />
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<uxap:ObjectPageSection title="{i18n>common.statistics}" visible="{detail>/hasStats}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<uxap:blocks>
							<TextArea value="{detail>/stats}" editable="false" rows="12" width="100%" growing="false" />
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<uxap:ObjectPageSection title="{i18n>common.advancedJson}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<uxap:blocks>
							<VBox>
								<TextArea value="{detail>/json}" editable="true" rows="18" width="100%" growing="false" />
								<Button text="{i18n>common.applyJson}" icon="sap-icon://synchronize" press=".onApplyJson" class="sapUiSmallMarginTop" />
							</VBox>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>

		<uxap:footer>
			<OverflowToolbar>
				<Button text="{i18n>common.delete}" type="Reject" icon="sap-icon://delete" press=".onDelete" visible="{= !${detail>/isNew} }" />
				<ToolbarSpacer />
				<Button text="{i18n>common.save}" type="Emphasized" icon="sap-icon://save" press=".onSave" />
			</OverflowToolbar>
		</uxap:footer>
	</uxap:ObjectPageLayout>
</mvc:View>
