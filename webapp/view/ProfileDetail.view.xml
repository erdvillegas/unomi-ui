<mvc:View
	controllerName="unomi.ui.controller.ProfileDetail"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	displayBlock="true">
	<Page
		title="{detail>/profileId}"
		showNavButton="true"
		navButtonPress=".onNavBack"
		busy="{detail>/busy}"
		busyIndicatorDelay="0">
		<Panel headerText="{i18n>properties}" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
			<VBox id="propsHost" />
		</Panel>

		<Panel headerText="{i18n>aliases}" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
			<headerToolbar>
				<Toolbar>
					<Title text="{i18n>aliases}" />
					<ToolbarSpacer />
					<Input id="aliasInput" placeholder="{i18n>aliasPlaceholder}" width="14rem" />
					<Button text="{i18n>add}" icon="sap-icon://add" press=".onAddAlias" />
				</Toolbar>
			</headerToolbar>
			<List items="{detail>/aliases}" mode="Delete" delete=".onRemoveAlias" noDataText="{i18n>noData}">
				<StandardListItem title="{detail>itemId}" />
			</List>
		</Panel>

		<Panel headerText="{i18n>privacy}" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
			<VBox class="sapUiSmallMargin">
				<HBox alignItems="Center" class="sapUiTinyMarginBottom">
					<Switch state="{detail>/anonBrowsing}" change=".onToggleAnonBrowsing" />
					<Label text="{i18n>anonBrowsing}" class="sapUiSmallMarginBegin" />
				</HBox>
				<HBox>
					<Button text="{i18n>anonymize}" icon="sap-icon://key-user-settings" press=".onAnonymize" class="sapUiTinyMarginEnd" />
					<Button text="{i18n>deleteData}" type="Reject" icon="sap-icon://delete" press=".onDeleteData" />
				</HBox>
			</VBox>
		</Panel>

		<Panel headerText="{i18n>segments}" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
			<List items="{detail>/segments}" noDataText="{i18n>noData}">
				<StandardListItem title="{detail>name}" description="{detail>id}" />
			</List>
		</Panel>

		<Panel headerText="{i18n>sessions}" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
			<Table
				items="{detail>/sessions}"
				mode="SingleSelectMaster"
				itemPress=".onSessionPress"
				noDataText="{i18n>noData}">
				<columns>
					<Column><Text text="{i18n>colId}" /></Column>
					<Column><Text text="{i18n>colTimestamp}" /></Column>
					<Column><Text text="{i18n>colDuration}" /></Column>
				</columns>
				<items>
					<ColumnListItem type="Active">
						<cells>
							<Text text="{detail>itemId}" />
							<Text text="{detail>timeStamp}" />
							<Text text="{detail>duration}" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</Panel>

		<Panel headerText="{i18n>events}" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
			<Table items="{detail>/events}" noDataText="{i18n>selectSession}">
				<columns>
					<Column><Text text="{i18n>colType}" /></Column>
					<Column><Text text="{i18n>colScope}" /></Column>
					<Column><Text text="{i18n>colTimestamp}" /></Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{detail>eventType}" />
							<Text text="{detail>scope}" />
							<Text text="{detail>timeStamp}" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</Panel>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="{i18n>save}" type="Emphasized" icon="sap-icon://save" press=".onSave" />
			</Toolbar>
		</footer>
	</Page>
</mvc:View>
