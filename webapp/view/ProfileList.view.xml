<mvc:View
	controllerName="unomi.ui.controller.ProfileList"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns="sap.m"
	displayBlock="true">
	<Page title="Profiles ({list>/total})" busy="{list>/busy}" busyIndicatorDelay="0">
		<subHeader>
			<Toolbar>
				<SearchField placeholder="{i18n>search}" search=".onSearch" width="100%" />
			</Toolbar>
		</subHeader>
		<Panel headerText="{i18n>queryBuilder}" expandable="true" expanded="false" class="sapUiResponsiveMargin" width="auto">
			<VBox>
				<VBox id="queryHost" />
				<Toolbar>
					<Select id="savedQueries" items="{query>/saved}" width="12rem">
						<core:Item key="{query>}" text="{query>}" />
					</Select>
					<Button text="{i18n>loadQuery}" icon="sap-icon://open-folder" press=".onLoadQuery" />
					<Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDeleteQuery" />
					<ToolbarSpacer />
					<Input id="queryName" placeholder="{i18n>queryName}" width="12rem" />
					<Button text="{i18n>save}" icon="sap-icon://save" press=".onSaveQuery" />
					<Button text="{i18n>runQuery}" type="Emphasized" icon="sap-icon://search" press=".onRunQuery" />
				</Toolbar>
			</VBox>
		</Panel>
		<Table
			id="profilesTable"
			items="{list>/profiles}"
			mode="SingleSelectMaster"
			itemPress=".onProfilePress"
			noDataText="{i18n>noData}">
			<columns>
				<Column><Text text="{i18n>colId}" /></Column>
				<Column><Text text="{i18n>colEmail}" /></Column>
				<Column><Text text="{i18n>colScope}" /></Column>
			</columns>
			<items>
				<ColumnListItem type="Navigation">
					<cells>
						<Text text="{list>itemId}" />
						<Text text="{list>properties/email}" />
						<Text text="{list>scope}" />
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="{i18n>loadMore}" visible="{list>/canLoadMore}" press=".onLoadMore" />
			</Toolbar>
		</footer>
	</Page>
</mvc:View>
