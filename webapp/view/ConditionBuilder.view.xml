<mvc:View
	controllerName="unomi.ui.controller.ConditionBuilder"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	displayBlock="true">
	<Page
		title="{i18n>conditionEditor}: {cb>/name}"
		showNavButton="true"
		navButtonPress=".onNavBack"
		busy="{cb>/busy}"
		busyIndicatorDelay="0">
		<VBox id="tree" class="sapUiSmallMargin" />
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="{i18n>save}" type="Emphasized" icon="sap-icon://save" press=".onSave" />
			</Toolbar>
		</footer>
	</Page>
</mvc:View>
