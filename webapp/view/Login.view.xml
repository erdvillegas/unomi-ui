<mvc:View
	controllerName="unomi.ui.controller.Login"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	displayBlock="true">
	<Page title="{i18n>loginTitle}">
		<VBox width="22rem" class="sapUiLargeMargin">
			<Input id="userInput" value="karaf" placeholder="{i18n>user}" />
			<Input id="passInput" value="karaf" type="Password" placeholder="{i18n>password}" submit=".onLogin" class="sapUiSmallMarginTop" />
			<Button text="{i18n>connect}" type="Emphasized" press=".onLogin" class="sapUiSmallMarginTop" />
		</VBox>
	</Page>
</mvc:View>
