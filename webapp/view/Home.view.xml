<mvc:View
	controllerName="unomi.ui.controller.Home"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<Page showHeader="false" backgroundDesign="List" class="sapUiContentPadding">
		<VBox class="sapUiMediumMargin">
			<Title text="{app>/appName}" level="H1" titleStyle="H1" />
			<Text text="{i18n>homeSubtitle}" class="sapUiTinyMarginTop" />

			<!-- Sin sesión: sólo un aviso + acceso, ningún control de administración. -->
			<MessageStrip visible="{= !${home>/authed} }" type="Information" showIcon="true"
				text="{i18n>homeLoggedOutHint}" class="sapUiMediumMarginTop sapUiSmallMarginBottom" />
			<Button visible="{= !${home>/authed} }" text="{i18n>connect}" type="Emphasized"
				icon="sap-icon://log" press=".onLogin" width="12rem" />

			<!-- Con sesión: grupo de tiles estilo Launchpad (Horizon). -->
			<FlexBox visible="{home>/authed}" wrap="Wrap" class="sapUiMediumMarginTop">
				<GenericTile header="{i18n>profiles}" subheader="{i18n>homeProfiles}" press=".onNav" app:nav="profiles" class="sapUiTinyMargin" width="15rem">
					<tileContent><TileContent><content><ImageContent src="sap-icon://person-placeholder" /></content></TileContent></tileContent>
				</GenericTile>
				<GenericTile header="{i18n>events}" subheader="{i18n>homeEvents}" press=".onNav" app:nav="events" class="sapUiTinyMargin" width="15rem">
					<tileContent><TileContent><content><ImageContent src="sap-icon://newspaper" /></content></TileContent></tileContent>
				</GenericTile>
				<GenericTile header="{i18n>segments}" subheader="{i18n>homeSegments}" press=".onNav" app:nav="segments" class="sapUiTinyMargin" width="15rem">
					<tileContent><TileContent><content><ImageContent src="sap-icon://group" /></content></TileContent></tileContent>
				</GenericTile>
				<GenericTile header="{i18n>scoring}" subheader="{i18n>homeScoring}" press=".onNav" app:nav="scoring" class="sapUiTinyMargin" width="15rem">
					<tileContent><TileContent><content><ImageContent src="sap-icon://target-group" /></content></TileContent></tileContent>
				</GenericTile>
				<GenericTile header="{i18n>campaigns}" subheader="{i18n>homeCampaigns}" press=".onNav" app:nav="campaigns" class="sapUiTinyMargin" width="15rem">
					<tileContent><TileContent><content><ImageContent src="sap-icon://marketing-campaign" /></content></TileContent></tileContent>
				</GenericTile>
				<GenericTile header="{i18n>configIO}" subheader="{i18n>homeConfigIO}" press=".onNav" app:nav="importConfig" class="sapUiTinyMargin" width="15rem">
					<tileContent><TileContent><content><ImageContent src="sap-icon://upload" /></content></TileContent></tileContent>
				</GenericTile>
			</FlexBox>
		</VBox>
	</Page>
</mvc:View>
