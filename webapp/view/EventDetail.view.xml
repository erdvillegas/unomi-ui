<mvc:View
	controllerName="unomi.ui.controller.EventDetail"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:form="sap.ui.layout.form"
	xmlns="sap.m"
	xmlns:uxap="sap.uxap"
	displayBlock="true">
	<uxap:ObjectPageLayout
		showTitleInHeaderContent="false"
		busy="{detail>/busy}"
		busyIndicatorDelay="0">
		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:heading>
					<Title text="{detail>/title}" />
				</uxap:heading>
				<uxap:snappedContent>
					<ObjectStatus text="{detail>/e/eventType}" state="Information" />
				</uxap:snappedContent>
				<uxap:navigationActions>
					<Button icon="sap-icon://nav-back" tooltip="{i18n>common.back}" press=".onNavBack" />
				</uxap:navigationActions>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>

		<uxap:headerContent>
			<FlexBox wrap="Wrap" alignItems="Start">
				<VBox class="sapUiMediumMarginEnd">
					<Label text="{i18n>col.type}" />
					<ObjectStatus text="{detail>/e/eventType}" state="Information" />
				</VBox>
				<VBox class="sapUiMediumMarginEnd">
					<Label text="{i18n>col.scope}" />
					<Text text="{detail>/e/scope}" />
				</VBox>
				<VBox class="sapUiMediumMarginEnd">
					<Label text="{i18n>col.profile}" />
					<Text text="{detail>/e/profileId}" />
				</VBox>
				<VBox>
					<Label text="{i18n>col.timestamp}" />
					<Text text="{detail>/e/timeStamp}" />
				</VBox>
			</FlexBox>
		</uxap:headerContent>

		<uxap:sections>
			<uxap:ObjectPageSection title="{i18n>event.detail}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<uxap:blocks>
							<form:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="3">
								<Label text="{i18n>col.id}" /><Text text="{detail>/e/itemId}" />
								<Label text="{i18n>col.type}" /><Text text="{detail>/e/eventType}" />
								<Label text="{i18n>col.scope}" /><Text text="{detail>/e/scope}" />
								<Label text="{i18n>col.profile}" /><Text text="{detail>/e/profileId}" />
								<Label text="{i18n>col.session}" /><Text text="{detail>/e/sessionId}" />
								<Label text="{i18n>col.timestamp}" /><Text text="{detail>/e/timeStamp}" />
							</form:SimpleForm>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<uxap:ObjectPageSection title="JSON">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<uxap:blocks>
							<TextArea value="{detail>/json}" editable="false" growing="true" width="100%" rows="20" />
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
	</uxap:ObjectPageLayout>
</mvc:View>
