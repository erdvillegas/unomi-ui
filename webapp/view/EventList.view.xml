<mvc:View
	controllerName="unomi.ui.controller.EventList"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns="sap.m"
	displayBlock="true">
	<Page title="{i18n>module.events} ({list>/total})" busy="{list>/busy}" busyIndicatorDelay="0">
		<subHeader>
			<Toolbar>
				<Label text="{i18n>col.type}" />
				<Select items="{list>/types}" selectedKey="{list>/f/eventType}" width="12rem">
					<core:Item key="{list>key}" text="{list>text}" />
				</Select>
				<Input value="{list>/f/scope}" placeholder="{i18n>col.scope}" width="9rem" submit=".onSearch" />
				<Input value="{list>/f/profileId}" placeholder="{i18n>col.profile}" width="14rem" submit=".onSearch" />
				<ToolbarSpacer />
				<Button text="{i18n>query.run}" type="Emphasized" icon="sap-icon://search" press=".onSearch" />
			</Toolbar>
		</subHeader>
		<Table
			items="{list>/events}"
			mode="SingleSelectMaster"
			itemPress=".onEventPress"
			noDataText="{i18n>common.noData}">
			<columns>
				<Column><Text text="{i18n>col.type}" /></Column>
				<Column><Text text="{i18n>col.scope}" /></Column>
				<Column><Text text="{i18n>col.profile}" /></Column>
				<Column><Text text="{i18n>col.timestamp}" /></Column>
			</columns>
			<items>
				<ColumnListItem type="Navigation">
					<cells>
						<Text text="{list>eventType}" />
						<Text text="{list>scope}" />
						<Text text="{list>profileId}" />
						<Text text="{list>timeStamp}" />
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="{i18n>common.loadMore}" visible="{list>/canLoadMore}" press=".onLoadMore" />
			</Toolbar>
		</footer>
	</Page>
</mvc:View>
