        },
        {
          "name": "importConfigDetail",
          "pattern": "importConfig/{itemId}",
          "target": "importConfigDetail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "exportConfig",
          "pattern": "exportConfig",
          "target": "configIO",
          "layout": "OneColumn"
        },
        {
          "name": "exportConfigDetail",
          "pattern": "exportConfig/{itemId}",
          "target": "exportConfigDetail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "queries",
          "pattern": "queries",
          "target": "queries",
          "layout": "OneColumn"
        },
        {
          "name": "dataProtection",
          "pattern": "dataProtection",
          "target": "dataProtection",
          "layout": "OneColumn"
        },
        {
          "name": "definitions",
          "pattern": "definitions",
          "target": "definitions",
          "layout": "OneColumn"
        },
        {
          "name": "settings",
          "pattern": "settings",
          "target": "settings",
          "layout": "OneColumn"
        },
        {
          "name": "info",
          "pattern": "info",
          "target": "info",
          "layout": "OneColumn"
        }
