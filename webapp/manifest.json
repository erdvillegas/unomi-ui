{
  "_version": "1.60.0",
  "sap.app": {
    "id": "unomi.ui",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.1"
    },
    "dataSources": {
      "unomi": {
        "uri": "/cxs/",
        "type": "JSON"
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "contentDensities": {
      "cozy": true,
      "compact": false
    },
    "rootView": {
      "viewName": "unomi.ui.view.App",
      "type": "XML",
      "id": "app",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {},
        "sap.uxap": {},
        "sap.tnt": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "unomi.ui.i18n.i18n",
          "supportedLocales": [
            "",
            "en",
            "es"
          ],
          "fallbackLocale": ""
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "unomi.ui.view",
        "controlId": "fcl",
        "async": true
      },
      "routes": [
        {
          "name": "home",
          "pattern": "",
          "target": "home",
          "layout": "OneColumn"
        },
        {
          "name": "login",
          "pattern": "login",
          "target": "login",
          "layout": "OneColumn"
        },
        {
          "name": "profiles",
          "pattern": "profiles",
          "target": "profiles",
          "layout": "OneColumn"
        },
        {
          "name": "profileDetail",
          "pattern": "profiles/{profileId}",
          "target": "profileDetail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "events",
          "pattern": "events",
          "target": "events",
          "layout": "OneColumn"
        },
        {
          "name": "eventDetail",
          "pattern": "events/{eventId}",
          "target": "eventDetail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "segments",
          "pattern": "segments",
          "target": "segments",
          "layout": "OneColumn"
        },
        {
          "name": "segmentDetail",
          "pattern": "segments/{itemId}",
          "target": "segmentDetail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "rules",
          "pattern": "rules",
          "target": "rules",
          "layout": "OneColumn"
        },
        {
          "name": "ruleDetail",
          "pattern": "rules/{itemId}",
          "target": "ruleDetail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "scoring",
          "pattern": "scoring",
          "target": "scoring",
          "layout": "OneColumn"
        },
        {
          "name": "scoringDetail",
          "pattern": "scoring/{itemId}",
          "target": "scoringDetail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "goals",
          "pattern": "goals",
          "target": "goals",
          "layout": "OneColumn"
        },
        {
          "name": "goalDetail",
          "pattern": "goals/{itemId}",
          "target": "goalDetail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "campaigns",
          "pattern": "campaigns",
          "target": "campaigns",
          "layout": "OneColumn"
        },
        {
          "name": "campaignDetail",
          "pattern": "campaigns/{itemId}",
          "target": "campaignDetail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "scopes",
          "pattern": "scopes",
          "target": "scopes",
          "layout": "OneColumn"
        },
        {
          "name": "scopeDetail",
          "pattern": "scopes/{itemId}",
          "target": "scopeDetail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "lists",
          "pattern": "lists",
          "target": "lists",
          "layout": "OneColumn"
        },
        {
          "name": "listDetail",
          "pattern": "lists/{itemId}",
          "target": "listDetail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "properties",
          "pattern": "properties",
          "target": "properties",
          "layout": "OneColumn"
        },
        {
          "name": "propertyDetail",
          "pattern": "properties/{itemId}",
          "target": "propertyDetail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "importConfig",
